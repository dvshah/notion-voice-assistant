# 1. Google Gemini API Key (Free tier available at https://aistudio.google.com/api-keys)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# 2. Notion Internal Integration Secret (Create at https://www.notion.so/profile/integrations)
# Share ANY databases or checklist pages with your integration and they are auto-discovered!
NOTION_API_KEY=ntn_your_notion_secret_token_here

# 3. Access PIN (Recommended when hosting publicly so only your phone/MacroDroid can access Notion)
# Leave blank for no lock screen locally.
APP_ACCESS_PIN=

# 4. Optional: Explicit Database IDs (Not required when shared with your integration)
NOTION_SHOPPING_DB_ID=
NOTION_TODO_DB_ID=
NOTION_NOTES_DB_ID=

# Server Configuration
HOST=0.0.0.0
PORT=8000
